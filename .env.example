# Supabase — from your project's API settings page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No service role key. Every query runs as the signed-in user so that row-level
# security applies; a service role key bypasses RLS entirely, and this app
# writes scraped web pages into the database. Don't add one back without a
# reason that survives that sentence.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Extraction defaults to claude-opus-4-8 at high effort. Every model
# down to claude-haiku-4-5 produced identical output on the cards tested, at
# roughly 1/7th the cost and no latency change — but the awkward cards are the
# ones that separate them, and a wrong quantity fails silently.
# EXTRACTION_MODEL=claude-haiku-4-5
# EXTRACTION_EFFORT=low
