# Copy to .env.local. These two are NOT secret: they are inlined into the
# client bundle by `next build`, which is what the anon key is designed for —
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Secrets do NOT belong in any .env file.
#
# OpenNext compiles every mode's .env files into .open-next/cloudflare/
# next-env.mjs and ships it inside the Worker script. A key in .env.local — or
# .env.development.local — is uploaded to Cloudflare in plaintext, whether or
# not the running mode ever reads it.
#
# Instead:
#   local dev   copy .dev.vars.example to .dev.vars and fill it in
#   production  npx wrangler secret put ANTHROPIC_API_KEY
#
# See src/lib/server-env.ts.
# ---------------------------------------------------------------------------

# No service role key. Every query runs as the signed-in user so that row-level
# security applies; a service role key bypasses RLS entirely, and this app
# writes scraped web pages into the database. Don't add one back without a
# reason that survives that sentence.

# Optional, and not secret. Extraction defaults to claude-opus-4-8 at high
# effort. Every model down to claude-haiku-4-5 produced identical output on the
# cards tested, at roughly 1/7th the cost and no latency change — but the
# awkward cards are the ones that separate them, and a wrong quantity fails
# silently.
# EXTRACTION_MODEL=claude-haiku-4-5
# EXTRACTION_EFFORT=low
