{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-vault",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  // Required by the Next.js server runtime and the Anthropic SDK.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }

  // No `limits.cpu_ms` here: the Free plan rejects the field outright, and its
  // ceiling is 10ms of CPU per request regardless. Waiting on the Anthropic API
  // costs no CPU, but base64-encoding a multi-megabyte PDF or photo does, and
  // that alone will exceed 10ms.
  //
  // On Workers Paid the default is 30s, which is ample. Only raise it if a
  // real invocation is measured against it:
  //   "limits": { "cpu_ms": 300000 }

  // Runtime secrets are not stored here. Set them once per environment:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  //
  // NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are inlined
  // into the client bundle at build time, so they must be present in the
  // build environment (.env.local locally, build vars in CI) rather than here.
}
